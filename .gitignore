# Ignore IDE specific configurations.
.idea
*.iml
.vscode

# Ignore custom configs but allow changes to the sample.
.env
config/*
!config/config.sample.yml

# Ignore installed dependencies.
.bundle
bin
vendor

# Ignore Python environment and documentation build outputs.
.venv
.cache
site

# Ignore import and export files.
./*.csv
./*.json

# Ignore test outputs
coverage
